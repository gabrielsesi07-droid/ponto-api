DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
# First installation only: random server-side secret, at least 32 characters.
# Remove after creating the first coordinator. Never use NEXT_PUBLIC_ for this value.
HORACERTA_BOOTSTRAP_TOKEN=
# Only for explicitly running scripts/reset-pin.mjs; identifies the authorized operator in audit.
HORACERTA_RECOVERY_OPERATOR=
# Isolated database for explicit integration tests. Never point this at production.
TEST_DATABASE_URL=
# Server-only secret (random, at least 32 characters) for /api/cron/push.
# Scheduling is intentionally unset until the Vercel plan/frequency is confirmed.
CRON_SECRET=
# Optional: server-side key with Places API (New) enabled. Manual addresses work without it.
GOOGLE_MAPS_API_KEY=
